configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Apps";
    font: "Inconsolata Nerd Font Mono 12";
}

* {
    graphite: #2e3440cc;
    graphite-deep: #1f232bcc;
    paper: #eceff4;
    mist: #d8dee9;
    muted: #4c566a;
    selection: #eceff41f;
    urgent: #bf616a;
    background: @graphite;
    foreground: @paper;
}

window {
    fullscreen: true;
    width: 100%;
    height: 100%;
    location: center;
    anchor: center;
    background-color: @background;
    border: 0px;
    border-radius: 0px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
    padding: 19% 26%;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    padding: 14px 18px;
    spacing: 12px;
    background-color: @graphite-deep;
    border: 1px;
    border-color: @muted;
    border-radius: 0px;
}

prompt {
    text-color: @mist;
}

entry {
    text-color: @foreground;
    placeholder: "Search applications";
    placeholder-color: @mist;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
    background-color: transparent;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    spacing: 12px;
    background-color: transparent;
    text-color: @foreground;
    border-radius: 0px;
}


element alternate.normal { background-color: transparent; text-color: @foreground; }

element selected {
    background-color: @selection;
    text-color: @paper;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 24px;
}