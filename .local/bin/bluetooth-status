#!/bin/sh
if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    printf "󰂲 off"
    exit 0
fi
connectedDevice=$(bluetoothctl devices Connected 2>/dev/null | sed "s/^Device [^ ]* //" | head -n 1)
if [ -n "$connectedDevice" ]; then
    printf "󰂱 %s" "$connectedDevice"
else
    printf "󰂯 on"
fi